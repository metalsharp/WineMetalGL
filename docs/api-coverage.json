{
  "project": "WineMetalGL",
  "release": "1.1.0",
  "host": {"os": "macOS", "minimum": "15.0", "architecture": "x86_64"},
  "guests": ["x86_64", "i386"],
  "prefix": "WINEARCH=wow64",
  "paths": {
    "compatibility": {"owner": "Wine/winemac.drv + legacy OpenGL", "status": "forwarded"},
    "metal": {"owner": "WineMetalGL sidecar", "status": "implemented"}
  },
  "entry_points": {
    "wgl": {
      "implemented": [
        "wglCreateContext", "wglCreateContextAttribsARB", "wglDeleteContext",
        "wglMakeCurrent", "wglGetCurrentContext", "wglGetCurrentDC",
        "wglChoosePixelFormatARB", "wglDescribePixelFormat",
        "wglGetPixelFormat", "wglSetPixelFormat", "wglSwapIntervalEXT",
        "wglGetProcAddress"
      ],
      "forwarded_or_driver_owned": ["wglShareLists"]
    },
    "gl_legacy": {
      "forwarded": "Wine's compatibility path covers the exported OpenGL 1.0-2.1 surface",
      "metal_owned": ["glViewport", "glClear", "glFlush", "glFinish", "glReadPixels"]
    },
    "gl_resources": {
      "metal_owned": [
        "glGenBuffers", "glBindBuffer", "glBufferData", "glBufferSubData", "glMapBuffer", "glVertexAttribPointer",
        "glEnableVertexAttribArray", "glDrawArrays", "glDrawElements",
        "glUniform1f", "glUniform2f", "glUniform3f", "glUniform4f",
        "glUniform1i", "glUniform2i", "glUniform3i", "glUniform4i",
        "glUniformMatrix2fv", "glUniformMatrix3fv", "glUniformMatrix4fv",
        "glGetUniformLocation", "glDrawArraysInstanced", "glDrawElementsInstanced",
        "glGenVertexArrays", "glBindVertexArray", "glVertexAttribDivisor",
        "glGenTextures", "glBindTexture", "glActiveTexture", "glTexImage2D",
        "glTexSubImage2D", "glTexParameteri", "glGenSamplers", "glBindSampler", "glSamplerParameteri", "glGenFramebuffers",
        "glBindFramebuffer", "glFramebufferTexture2D", "glCheckFramebufferStatus",
        "glClear", "glClearColor", "glDepthFunc", "glDepthMask", "glFenceSync", "glClientWaitSync", "glDeleteSync"
      ],
      "forwarded": ["glGenRenderbuffers", "glFramebufferRenderbuffer"]
    },
    "shader_stages": {
      "implemented": ["vertex", "fragment", "compute (buffer binding and dispatch)", "image load/store (2D rgba8)"],
      "compiler_only": [],
      "rejected": ["geometry", "tessellation", "mesh", "task", "ray-tracing"]
    }
  },
  "validated_profiles": [
    "GLSL 1.20 compatibility readback",
    "GLSL 3.30 vertex/fragment Metal draw/readback",
    "GLSL 4.50 vertex/fragment translation",
    "indexed GL 3.3-style draw with VBO/IBO, vertex attribute, and uniform",
    "texture sampling with sampler parameters",
    "color-texture and renderbuffer FBO attachment/readback",
    "instanced draw with depth attachment",
    "compute shader dispatch with SSBO writeback",
    "uniform-buffer object binding with Metal reflection",
    "compute imageStore with 2D rgba8 writeback",
    "arrays and elements indirect draw",
    "basic fixed-function immediate-mode triangle and texture path",
    "sampler object state",
    "real CAMetalLayer default-surface presentation",
    "x86_64 guest in WoW64",
    "i386 guest in WoW64"
  ],
  "not_advertised": [
    "complete Khronos OpenGL 4.6 conformance",
    "geometry/tessellation/transform-feedback emulation",
    "fixed-function display-list completeness, advanced lighting/matrix semantics, image formats beyond 2D rgba8, multi-draw indirect variants",
    "complete texture/sampler/FBO format matrix",
    "EGL/GLES entry points"
  ]
}
