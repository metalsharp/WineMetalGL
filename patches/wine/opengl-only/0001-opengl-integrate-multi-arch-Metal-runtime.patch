+#undef DECLARE_GLU_FUNC
+
+static INIT_ONCE glu_init_once = INIT_ONCE_STATIC_INIT;
+
+static BOOL CALLBACK load_glu_tessellator( INIT_ONCE *once, void *param, void **context )
+{
+    HMODULE module;
+
+    if (!(module = LoadLibraryW( L"glu32.dll" ))) return FALSE;
+
+#define LOAD_GLU_FUNC(name) \
+    do { if (!(p_##name = (typeof(name) *)GetProcAddress( module, #name ))) goto failed; } while (0)
+    LOAD_GLU_FUNC(gluNewTess);
+    LOAD_GLU_FUNC(gluDeleteTess);
+    LOAD_GLU_FUNC(gluTessBeginPolygon);
+    LOAD_GLU_FUNC(gluTessBeginContour);
+    LOAD_GLU_FUNC(gluTessVertex);
+    LOAD_GLU_FUNC(gluTessEndContour);
+    LOAD_GLU_FUNC(gluTessEndPolygon);
+    LOAD_GLU_FUNC(gluTessNormal);
+    LOAD_GLU_FUNC(gluTessCallback);
+#undef LOAD_GLU_FUNC
+    return TRUE;
+
+failed:
+    FreeLibrary( module );
+    return FALSE;
+}
