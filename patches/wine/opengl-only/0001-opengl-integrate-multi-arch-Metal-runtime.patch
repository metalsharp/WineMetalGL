+/*
+ * Loading glu32 at process attach creates an opengl32 <-> glu32 import cycle.
+ * Keep GLU optional and resolve the tessellator only for polygon font outlines.
+ */
+#define DECLARE_GLU_FUNC(name) static typeof(name) *p_##name
+DECLARE_GLU_FUNC(gluNewTess);
+DECLARE_GLU_FUNC(gluDeleteTess);
