diff --git a/dlls/ntdll/signal_arm64.c b/dlls/ntdll/signal_arm64.c
index c921f60..ca0149d 100644
--- a/dlls/ntdll/signal_arm64.c
+++ b/dlls/ntdll/signal_arm64.c
@@ -424,6 +424,7 @@ void CDECL RtlRestoreContext( CONTEXT *context, EXCEPTION_RECORD *rec )
     {
         ULONGLONG magic, armed, dispatcher_pc, guest_page_table, current_frame, callret_sp, returning_sp;
         ULONGLONG unix_state_dst, unix_state_src, unix_state_size, unix_state_armed;
+        ULONGLONG user_callback_jmpbuf;
     } *fex_recovery;
     BOOL fex_resume = FALSE;
 
@@ -442,7 +443,8 @@ void CDECL RtlRestoreContext( CONTEXT *context, EXCEPTION_RECORD *rec )
             fex_recovery->armed && fex_recovery->dispatcher_pc && fex_recovery->guest_page_table &&
             fex_recovery->current_frame && fex_recovery->callret_sp && fex_recovery->returning_sp &&
             fex_recovery->unix_state_armed && fex_recovery->unix_state_dst &&
-            fex_recovery->unix_state_src && fex_recovery->unix_state_size <= 0x2000)
+            fex_recovery->unix_state_src && fex_recovery->unix_state_size <= 0x2000 &&
+            (ULONG_PTR)jmp != fex_recovery->user_callback_jmpbuf)
         {
             memcpy( (void *)(ULONG_PTR)fex_recovery->unix_state_dst,
                     (const void *)(ULONG_PTR)fex_recovery->unix_state_src,
diff --git a/dlls/opengl32/Makefile.in b/dlls/opengl32/Makefile.in
index d2ec942..525733e 100644
--- a/dlls/opengl32/Makefile.in
+++ b/dlls/opengl32/Makefile.in
@@ -3,7 +3,6 @@ UNIXLIB   = opengl32.so
 EXTRADEFS = -D_OPENGL32_
 IMPORTLIB = opengl32
 IMPORTS   = user32 gdi32 advapi32 win32u
-DELAYIMPORTS = glu32
 UNIX_LIBS    = -lwin32u $(PTHREAD_LIBS)
 
 EXTRADLLFLAGS = -Wl,--image-base,0x7a800000
diff --git a/dlls/opengl32/make_opengl b/dlls/opengl32/make_opengl
index 5ddd16a..d11925c 100755
--- a/dlls/opengl32/make_opengl
+++ b/dlls/opengl32/make_opengl
@@ -482,7 +482,7 @@ sub generate_unix_thunk($$$$)
             {
                 $arg_type =~ s/\*$//;
                 $vars .= "    $arg_type$pname\_arg;\n";
-                $output_conv .= "    *(PTR32 *)UlongToPtr(params->$pname) = PtrToUlong( $pname\_arg );\n";
+                $output_conv .= "    *(PTR32 *)wow64_guest_ptr( params->$pname, sizeof(PTR32) ) = PtrToUlong( $pname\_arg );\n";
                 $call_args .= " &$pname\_arg,";
             }
             elsif ($arg_type =~ /(sizei|int)ptr/)
@@ -491,7 +491,19 @@ sub generate_unix_thunk($$$$)
             }
             elsif ($arg_type =~ /GLsync/)
             {
-                $call_args .= " get_unix_sync( ULongToPtr(params->$pname) ),";
+                $call_args .= " get_unix_sync( wow64_guest_ptr( params->$pname, 1 ) ),";
+            }
+            elsif ($name eq "wglCreateContextAttribsARB" && $pname eq "hShareContext")
+            {
+                $call_args .= " wow64_guest_ptr( params->$pname, 1 ),";
+            }
+            elsif ($name eq "wglMakeContextCurrentARB" && $pname eq "hglrc")
+            {
+                $call_args .= " wow64_guest_ptr( params->$pname, 1 ),";
+            }
+            elsif ($arg_type =~ /\*/)
+            {
+                $call_args .= " wow64_guest_ptr( params->$pname, 1 ),";
             }
             else
             {
@@ -500,7 +512,17 @@ sub generate_unix_thunk($$$$)
                 $need_lock = 1 if $arg_type =~ /GLsync/;
             }
         }
-        $call_args .= " UlongToHandle( params->ret )," if $func_ret =~ /HPBUFFERARB|HGLRC|GLsync/;
+        if ($func_ret =~ /HPBUFFERARB|HGLRC|GLsync/)
+        {
+            if ($name eq "wglCreateContextAttribsARB")
+            {
+                $call_args .= " wow64_guest_ptr( params->ret, 1 ),";
+            }
+            else
+            {
+                $call_args .= " UlongToHandle( params->ret ),";
+            }
+        }
         if (!is_void_func($func))
         {
             my $ret_type = get_arg_type( $func->[0] );
diff --git a/dlls/opengl32/unix_private.h b/dlls/opengl32/unix_private.h
index 8f05f62..ab0a8a0 100644
--- a/dlls/opengl32/unix_private.h
+++ b/dlls/opengl32/unix_private.h
@@ -65,19 +65,24 @@ static inline GLsync get_unix_sync( GLsync sync )
 
 #ifdef _WIN64
 
+static inline void *wow64_guest_ptr( PTR32 ptr, SIZE_T size )
+{
+    return ptr ? ntdll_wow64_guest_to_host_ptr( ptr, size ) : NULL;
+}
+
 static inline void *copy_wow64_ptr32s( UINT_PTR address, ULONG count )
 {
-    ULONG *ptrs = (ULONG *)address;
+    ULONG *ptrs = address ? ntdll_wow64_guest_to_host_ptr( address, count * sizeof(*ptrs) ) : NULL;
     void **tmp;
 
     if (!ptrs || !(tmp = calloc( count, sizeof(*tmp) ))) return NULL;
-    while (count--) tmp[count] = ULongToPtr(ptrs[count]);
+    while (count--) tmp[count] = wow64_guest_ptr( ptrs[count], 1 );
     return tmp;
 }
 
 static inline TEB *get_teb64( ULONG teb32 )
 {
-    TEB32 *teb32_ptr = ULongToPtr( teb32 );
+    TEB32 *teb32_ptr = ntdll_wow64_guest_to_host_ptr( teb32, sizeof(*teb32_ptr) );
     return (TEB *)((char *)teb32_ptr + teb32_ptr->WowTebOffset);
 }
 
