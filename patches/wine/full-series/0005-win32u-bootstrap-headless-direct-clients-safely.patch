From 7753e5871049b7f4506e048595dc797f584fbfe9 Mon Sep 17 00:00:00 2001
From: Avery Felts <averyfelts@Averys-MacBook-Air.local>
Date: Mon, 27 Jul 2026 01:56:02 -0600
Subject: [PATCH 05/19] win32u: bootstrap headless direct clients safely

---
 dlls/win32u/class.c          | 20 ++++++++++++++++++++
 dlls/win32u/driver.c         |  6 +++++-
 dlls/win32u/ntuser_private.h |  1 +
 dlls/win32u/winstation.c     | 24 ++++++++++++++++++++++--
 4 files changed, 48 insertions(+), 3 deletions(-)

diff --git a/dlls/win32u/class.c b/dlls/win32u/class.c
index 24f7e64..216216e 100644
--- a/dlls/win32u/class.c
+++ b/dlls/win32u/class.c
@@ -350,6 +350,10 @@ NTSTATUS WINAPI NtUserInitializeClientPfnArrays( const ntuser_client_func_ptr *c
     user32_module = user_module;
 
     pthread_once( &init_once, init_user );
+    /* Direct win32u users may have created the server desktop before user32
+     * was initialized.  Complete builtin registration now that its callback
+     * table and module handle are valid. */
+    register_builtin_classes();
     return STATUS_SUCCESS;
 }
 
@@ -1113,7 +1117,23 @@ static void register_builtins(void)
 void register_builtin_classes(void)
 {
     static pthread_once_t init_once = PTHREAD_ONCE_INIT;
+    struct user_thread_info *thread_info = get_user_thread_info();
+
+    /* win32u also serves clients such as DXVK without a user32 callback
+     * table.  Registering the full builtin set in that state enters callbacks
+     * that do not exist for the direct client.  Desktop/Message are installed
+     * separately as the only server prerequisite. */
+    if (!user32_module) return;
+
+    /* Registering a class may load its cursor.  On the macOS driver that
+     * crosses back through user32 to create a desktop window, which in turn
+     * asks for the builtin classes.  pthread_once aborts on that same-thread
+     * recursion.  The outer registration owns completion; the reentrant
+     * caller only needs to avoid entering pthread_once again. */
+    if (thread_info->registering_builtin_classes) return;
+    thread_info->registering_builtin_classes = TRUE;
     pthread_once( &init_once, register_builtins );
+    thread_info->registering_builtin_classes = FALSE;
 }
 
 /***********************************************************************
diff --git a/dlls/win32u/driver.c b/dlls/win32u/driver.c
index 27259fd..cd0212b 100644
--- a/dlls/win32u/driver.c
+++ b/dlls/win32u/driver.c
@@ -25,6 +25,7 @@
 
 #include <assert.h>
 #include <pthread.h>
+#include <stdlib.h>
 
 #include "ntstatus.h"
 #include "ntgdi_private.h"
@@ -1038,7 +1039,10 @@ static void load_display_driver(void)
     USEROBJECTFLAGS flags;
     HWINSTA winstation;
 
-    if (is_service_process() || !load_desktop_driver( get_desktop_window() ) || user_driver == &lazy_load_driver)
+    /* Headless probe mode creates a server desktop for Win32 queue semantics,
+     * but must not instantiate a host macOS desktop driver. */
+    if (is_service_process() || getenv( "WINE_NO_EXPLORER" ) ||
+        !load_desktop_driver( get_desktop_window() ) || user_driver == &lazy_load_driver)
     {
         winstation = NtUserGetProcessWindowStation();
         if (!NtUserGetObjectInformation( winstation, UOI_FLAGS, &flags, sizeof(flags), NULL )
diff --git a/dlls/win32u/ntuser_private.h b/dlls/win32u/ntuser_private.h
index dc14811..5b567c3 100644
--- a/dlls/win32u/ntuser_private.h
+++ b/dlls/win32u/ntuser_private.h
@@ -104,6 +104,7 @@ struct mouse_tracking_info
 struct user_thread_info
 {
     struct ntuser_thread_info    *client_info;            /* Data shared with client */
+    BOOL                          registering_builtin_classes; /* avoid same-thread class-init recursion */
     HANDLE                        server_queue;           /* Handle to server-side queue */
     HANDLE                        idle_event;             /* Handle to the process idle event */
     LONGLONG                      last_driver_time;       /* Get/PeekMessage driver event time */
diff --git a/dlls/win32u/winstation.c b/dlls/win32u/winstation.c
index 3da9acd..2f37dcc 100644
--- a/dlls/win32u/winstation.c
+++ b/dlls/win32u/winstation.c
@@ -794,8 +794,25 @@ HWND get_desktop_window(void)
 
     if (thread_info->top_window) return thread_info->top_window;
 
-    /* don't create an actual explorer desktop window for services */
-    is_service = is_service_process();
+    /* Some non-user32 clients reach win32u directly (notably the x64 DXVK
+     * path).  Their process never calls NtUserInitializeClientPfnArrays(),
+     * which is normally where the window station and initial desktop are
+     * attached.  Establish that idempotent process/thread state at the first
+     * UI consumer instead of requiring every native caller to bootstrap
+     * user32. */
+    winstation_init();
+
+    /* The server creates the desktop and message windows from these two
+     * builtin classes.  Direct win32u clients have not run init_user(), so
+     * register just this minimal server-side prerequisite before forcing the
+     * desktop window into existence. */
+    register_desktop_class();
+
+    /* Don't create an actual explorer desktop window for services.  The
+     * opt-in headless mode is for offscreen automation, where a server
+     * desktop is sufficient and starting an unrelated x64 shell would add a
+     * second guest-execution requirement before the test process begins. */
+    is_service = is_service_process() || getenv( "WINE_NO_EXPLORER" );
 
     SERVER_START_REQ( get_desktop_window )
     {
@@ -810,6 +827,8 @@ HWND get_desktop_window(void)
 
     if (!thread_info->top_window)
     {
+        if (!is_service)
+        {
         static const WCHAR appnameW[] = {'\\','?','?','\\','C',':','\\','w','i','n','d','o','w','s',
             '\\','s','y','s','t','e','m','3','2','\\','e','x','p','l','o','r','e','r','.','e','x','e',0};
         static const WCHAR cmdlineW[] = {'"','C',':','\\','w','i','n','d','o','w','s','\\',
@@ -878,6 +897,7 @@ HWND get_desktop_window(void)
             NtClose( process );
         }
         else ERR_(win)( "failed to start explorer %x\n", status );
+        }
 
         SERVER_START_REQ( get_desktop_window )
         {
