From b5c82951948e34607f03785d815e0999a9865178 Mon Sep 17 00:00:00 2001
From: Avery Felts <averyfelts@Averys-MacBook-Air.local>
Date: Mon, 27 Jul 2026 09:33:50 -0600
Subject: [PATCH 07/19] wow64: initialize FEX provider on arm64

---
 dlls/ntdll/ntdll.spec |  1 +
 dlls/ntdll/process.c  | 12 ++++++++++++
 dlls/wow64/syscall.c  | 45 ++++++++++++++++++++++++++++++++-----------
 3 files changed, 47 insertions(+), 11 deletions(-)

diff --git a/dlls/ntdll/ntdll.spec b/dlls/ntdll/ntdll.spec
index 0b6d9b2..10d42ee 100644
--- a/dlls/ntdll/ntdll.spec
+++ b/dlls/ntdll/ntdll.spec
@@ -1150,6 +1150,7 @@
 @ stdcall -arch=win64 RtlWow64PushCrossProcessWorkOntoWorkList(ptr ptr ptr)
 @ stdcall -arch=win64 RtlWow64RequestCrossProcessHeavyFlush(ptr)
 @ stdcall -arch=win64 RtlWow64SetThreadContext(long ptr)
+@ stdcall -arch=win64 RtlWow64SuspendThread(long ptr)
 @ stub RtlWriteMemoryStream
 @ stdcall RtlWriteRegistryValue(long ptr wstr long ptr long)
 @ stub RtlZeroHeap
diff --git a/dlls/ntdll/process.c b/dlls/ntdll/process.c
index e450eea..fd41c4d 100644
--- a/dlls/ntdll/process.c
+++ b/dlls/ntdll/process.c
@@ -233,6 +233,18 @@ NTSTATUS WINAPI RtlWow64SetThreadContext( HANDLE handle, const WOW64_CONTEXT *co
     return NtSetInformationThread( handle, ThreadWow64Context, context, sizeof(*context) );
 }
 
+/******************************************************************************
+ *              RtlWow64SuspendThread  (NTDLL.@)
+ *
+ * FEX uses this entrypoint before inspecting another emulated thread's CPU
+ * area. The Wine server already owns the suspend count and native stop
+ * protocol, so keep the WoW64-facing wrapper at that boundary.
+ */
+NTSTATUS WINAPI RtlWow64SuspendThread( HANDLE handle, ULONG *count )
+{
+    return NtSuspendThread( handle, count );
+}
+
 /******************************************************************************
  *              RtlWow64GetThreadSelectorEntry  (NTDLL.@)
  */
diff --git a/dlls/wow64/syscall.c b/dlls/wow64/syscall.c
index d52c52f..fe0848d 100644
--- a/dlls/wow64/syscall.c
+++ b/dlls/wow64/syscall.c
@@ -40,6 +40,17 @@ ULONG_PTR args_alignment = 0;
 ULONG_PTR highest_user_address = 0x7ffeffff;
 ULONG_PTR default_zero_bits = 0x7fffffff;
 
+/* On Darwin arm64, the i386 guest address space is mapped in a high 4GB
+ * arena.  Context values remain guest addresses; translate only when this
+ * native ARM64 wrapper dereferences guest memory. */
+static inline void *wow64_guest_ptr( ULONG_PTR addr )
+{
+#if defined(__aarch64__)
+    if (addr) addr += (ULONG_PTR)NtCurrentTeb32() & ~((ULONG_PTR)0xffffffff);
+#endif
+    return (void *)addr;
+}
+
 typedef NTSTATUS (WINAPI *syscall_thunk)( UINT *args );
 
 static const syscall_thunk syscall_thunks[] =
@@ -154,8 +165,8 @@ static EXCEPTION_RECORD *exception_record_32to64( const EXCEPTION_RECORD32 *rec3
     rec = Wow64AllocateTemp( sizeof(*rec) );
     rec->ExceptionCode = rec32->ExceptionCode;
     rec->ExceptionFlags = rec32->ExceptionFlags;
-    rec->ExceptionRecord = rec32->ExceptionRecord ? exception_record_32to64( ULongToPtr(rec32->ExceptionRecord) ) : NULL;
-    rec->ExceptionAddress = ULongToPtr( rec32->ExceptionAddress );
+    rec->ExceptionRecord = rec32->ExceptionRecord ? exception_record_32to64( wow64_guest_ptr( rec32->ExceptionRecord ) ) : NULL;
+    rec->ExceptionAddress = wow64_guest_ptr( rec32->ExceptionAddress );
     rec->NumberParameters = rec32->NumberParameters;
     for (i = 0; i < EXCEPTION_MAXIMUM_PARAMETERS; i++)
         rec->ExceptionInformation[i] = rec32->ExceptionInformation[i];
@@ -239,7 +250,7 @@ static void __attribute__((used)) call_user_exception_dispatcher( EXCEPTION_RECO
             RtlGetExtendedContextLength( flags, &context_length );
 
             esp = LOWORD(ctx.SegSs) != ss32_sel ? NtCurrentTeb32()->SystemReserved1[0] : ctx.Esp;
-            stack = (struct exc_stack_layout32 *)ULongToPtr( (esp - offsetof(struct exc_stack_layout32, context) - context_length) & ~3 );
+            stack = (struct exc_stack_layout32 *)wow64_guest_ptr( (esp - offsetof(struct exc_stack_layout32, context) - context_length) & ~3 );
             stack->rec_ptr     = PtrToUlong( &stack->rec );
             stack->context_ptr = PtrToUlong( &stack->context );
             stack->rec         = *rec;
@@ -309,7 +320,7 @@ static void __attribute__((used)) call_raise_user_exception_dispatcher( ULONG co
             ctx.ContextFlags = CONTEXT_I386_CONTROL;
             pBTCpuGetContext( GetCurrentThread(), GetCurrentProcess(), NULL, &ctx );
             ctx.Esp -= sizeof(ULONG);
-            *(ULONG *)ULongToPtr( ctx.Esp ) = ctx.Eip;
+            *(ULONG *)wow64_guest_ptr( ctx.Esp ) = ctx.Eip;
             ctx.Eip = (ULONG_PTR)pKiRaiseUserExceptionDispatcher;
             pBTCpuSetContext( GetCurrentThread(), GetCurrentProcess(), NULL, &ctx );
         }
@@ -1034,16 +1045,22 @@ static DWORD WINAPI process_init( RTL_RUN_ONCE *once, void *param, void **contex
     GET_PTR( sdwhwin32 );
     syscall_tables[1] = *psdwhwin32;
 
-    pBTCpuProcessInit();
-
+    /* The ARM64 CPU provider allocates and names JIT code during process
+     * initialization.  Publish Wine's Unix-call dispatcher before entering
+     * it, otherwise that first native Unixlib call targets an uninitialized
+     * i386 dispatch slot. */
     module = (HMODULE)(ULONG_PTR)pLdrSystemDllInitBlock->ntdll_handle;
     init_image_mapping( module );
     GET_PTR( KiRaiseUserExceptionDispatcher );
     GET_PTR( __wine_syscall_dispatcher );
     GET_PTR( __wine_unix_call_dispatcher );
+    *p__wine_unix_call_dispatcher = PtrToUlong( p__wine_get_unix_opcode() );
+
+    TRACE( "fex-boundary: entering BTCpuProcessInit %p\n", pBTCpuProcessInit );
+    pBTCpuProcessInit();
+    TRACE( "fex-boundary: BTCpuProcessInit returned\n" );
 
     *p__wine_syscall_dispatcher = PtrToUlong( pBTCpuGetBopCode() );
-    *p__wine_unix_call_dispatcher = PtrToUlong( p__wine_get_unix_opcode() );
 
     if (wow64info->CpuFlags & WOW64_CPUFLAGS_SOFTWARE) create_cross_process_work_list( wow64info );
 
@@ -1068,7 +1085,12 @@ static void thread_init(void)
 {
     NtCurrentTeb32()->WOW32Reserved = PtrToUlong( pBTCpuGetBopCode() );
     NtCurrentTeb()->TlsSlots[WOW64_TLS_WOW64INFO] = wow64info;
-    if (pBTCpuThreadInit) pBTCpuThreadInit();
+    if (pBTCpuThreadInit)
+    {
+        TRACE( "fex-boundary: entering BTCpuThreadInit %p\n", pBTCpuThreadInit );
+        pBTCpuThreadInit();
+        TRACE( "fex-boundary: BTCpuThreadInit returned\n" );
+    }
 
     /* update initial context to jump to 32-bit LdrInitializeThunk (cf. 32-bit call_init_thunk) */
     switch (current_machine)
@@ -1079,7 +1101,7 @@ static void thread_init(void)
             ULONG *stack;
 
             pBTCpuGetContext( GetCurrentThread(), GetCurrentProcess(), NULL, &ctx );
-            ctx_ptr = (I386_CONTEXT *)ULongToPtr( ctx.Esp ) - 1;
+            ctx_ptr = (I386_CONTEXT *)wow64_guest_ptr( ctx.Esp ) - 1;
             *ctx_ptr = ctx;
             stack = (ULONG *)ctx_ptr;
             *(--stack) = 0;
@@ -1331,7 +1353,7 @@ void WINAPI Wow64ApcRoutine( ULONG_PTR arg1, ULONG_PTR arg2, ULONG_PTR arg3, CON
 
             pBTCpuGetContext( GetCurrentThread(), GetCurrentProcess(), NULL, &ctx );
 
-            stack = (struct apc_stack_layout32 *)ULongToPtr( ctx.Esp & ~3 ) - 1;
+            stack = (struct apc_stack_layout32 *)wow64_guest_ptr( ctx.Esp & ~3 ) - 1;
             stack->func      = arg1 >> 32;
             stack->arg1      = arg1;
             stack->arg2      = arg2;
@@ -1425,7 +1447,7 @@ NTSTATUS WINAPI Wow64KiUserCallbackDispatcher( ULONG id, void *args, ULONG len,
             pBTCpuGetContext( GetCurrentThread(), GetCurrentProcess(), NULL, &ctx );
             orig_ctx = ctx;
 
-            stack = ULongToPtr( (ctx.Esp - offsetof(struct callback_stack_layout32,args_data[len])) & ~15 );
+            stack = wow64_guest_ptr( (ctx.Esp - offsetof(struct callback_stack_layout32,args_data[len])) & ~15 );
             stack->eip  = ctx.Eip;
             stack->id   = id;
             stack->args = PtrToUlong( stack->args_data );
@@ -1487,6 +1509,7 @@ void WINAPI Wow64LdrpInitialize( CONTEXT *context )
 
     RtlRunOnceExecuteOnce( &init_done, process_init, NULL, NULL );
     thread_init();
+    TRACE( "fex-boundary: entering BTCpuSimulate %p\n", pBTCpuSimulate );
     cpu_simulate();
 }
 
