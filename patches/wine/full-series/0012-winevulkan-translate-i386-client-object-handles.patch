From 12796abb06137f390ab743e3a5a22a22837a4545 Mon Sep 17 00:00:00 2001
From: Avery Felts <averyfelts@Averys-MacBook-Air.local>
Date: Tue, 28 Jul 2026 00:53:55 -0600
Subject: [PATCH 12/19] winevulkan: translate i386 client object handles

---
 dlls/winevulkan/make_vulkan      |   82 +-
 dlls/winevulkan/vulkan.c         |   58 +-
 dlls/winevulkan/vulkan_private.h |    9 +-
 dlls/winevulkan/vulkan_thunks.c  | 4255 +++++++++++++++---------------
 4 files changed, 2259 insertions(+), 2145 deletions(-)

diff --git a/dlls/winevulkan/make_vulkan b/dlls/winevulkan/make_vulkan
index 71994e4..47fbcff 100755
--- a/dlls/winevulkan/make_vulkan
+++ b/dlls/winevulkan/make_vulkan
@@ -801,10 +801,28 @@ class Function(Type):
                 body += "    {0}_host = ({2}{0} && {1}) ? conversion_context_alloc(ctx, sizeof(*{0}_host) * {1}) : NULL;\n".format(
                     p.name, p.get_dyn_array_len(self.params, params_prefix, conv), params_prefix)
 
+        # A manual Unix thunk receives native ARM64 code but the i386 client
+        # stores dispatchable-handle pointers as guest VAs.  Translate the
+        # pointed-to handle into a native local; translating only the output
+        # storage address leaves the Unix implementation dereferencing the
+        # raw 32-bit handle.
+        wow64_handle_ptrs = []
+        if conv and self.name in MANUAL_UNIX_THUNKS:
+            for p in self.params:
+                if p.is_pointer() and (p.is_dispatchable() or p.type_name == "VkCommandPool") and not p.is_dynamic_array() and \
+                        not p.needs_variable(conv, self.unwrap):
+                    body += "    {0} {1}_host = ({0})wine_vk_wow64_guest_to_host_ptr((ULONG)(ULONG_PTR)*({0} *)wine_vk_wow64_guest_to_host_ptr({2}{1}));\n".format(
+                        p.type_name, p.name, params_prefix)
+                    wow64_handle_ptrs.append(p.name)
+
         # Build list of parameters containing converted and non-converted parameters.
         # The param itself knows if conversion is needed and applies it when we set conv=True.
         unwrap = Unwrap.NONE if self.name in MANUAL_UNIX_THUNKS else self.unwrap
-        params = ", ".join([p.variable(conv, unwrap, params_prefix) for p in self.params])
+        params = ", ".join(["&{}_host".format(p.name) if p.name in wow64_handle_ptrs
+                            else "({0})wine_vk_wow64_guest_to_host_ptr((ULONG)(ULONG_PTR){1}{2})".format(
+                                p.type_name, params_prefix, p.name)
+                            if conv and self.name in MANUAL_UNIX_THUNKS and p.type_name == "VkCommandPool" and not p.is_pointer()
+                            else p.variable(conv, unwrap, params_prefix) for p in self.params])
 
         if self.name in MANUAL_UNIX_THUNKS:
             func_prefix = "wine_"
@@ -1096,6 +1114,9 @@ class VkVariable(object):
             return True
         return self.is_pointer_pointer()
 
+    def is_function_pointer(self):
+        return self.type_name.startswith("PFN_")
+
     def is_handle(self):
         return type(self.type) is Handle
 
@@ -1210,7 +1231,12 @@ class VkVariable(object):
         else:
             ptr = ""
 
-        return f"{ptr}({cast_type})UlongToPtr({prefix}{self.name})"
+        # Function-pointer members contain guest code addresses, not guest data
+        # addresses.  Preserve those architectural values for Wine's callback
+        # path; parameter pointers still name client memory and are translated.
+        if isinstance(self, VkMember) and self.is_function_pointer():
+            return f"{ptr}({cast_type})UlongToPtr({prefix}{self.name})"
+        return f"{ptr}({cast_type})wine_vk_wow64_guest_to_host_ptr({prefix}{self.name})"
 
 
 class VkMember(VkVariable):
@@ -1337,6 +1363,24 @@ class VkMember(VkVariable):
                     # Nothing needed this yet.
                     LOGGER.warn("TODO: implement copying of static array for {0}.{1}".format(self.type_name, self.name))
 
+            elif conv and unwrap == Unwrap.NONE and self.type_name == "VkCommandPool":
+                # Wine's manual command-pool Unix entry points operate on a
+                # client object.  i386 stores that object as a guest VA even
+                # though Vulkan defines VkCommandPool as a non-dispatchable
+                # 64-bit handle.
+                if direction == Direction.INPUT:
+                    return "{0}{1} = ({2})wine_vk_wow64_guest_to_host_ptr({3}{1});\n".format(
+                        output, self.name, self.type_name, input)
+                return "{0}{1} = ({2})wine_vk_wow64_host_to_guest_ptr({3}{1});\n".format(
+                    output, self.name, self.type_name, input)
+
+            elif conv and self.is_handle() and self.handle.is_dispatchable():
+                if direction == Direction.INPUT:
+                    return "{0}{1} = ({2})wine_vk_wow64_guest_to_host_ptr({3}{1});\n".format(
+                        output, self.name, self.type_name, input)
+                return "{0}{1} = ({2})wine_vk_wow64_host_to_guest_ptr({3}{1});\n".format(
+                    output, self.name, self.type_name, input)
+
             elif self.is_handle() and self.is_wrapped():
                 if direction == Direction.OUTPUT:
                     LOGGER.error("OUTPUT parameter {0}.{1} cannot be unwrapped".format(self.type_name, self.name))
@@ -1367,9 +1411,13 @@ class VkMember(VkVariable):
             bytes_count = " * ".join(self.array_lens + [f"sizeof({self.type_name})"])
             return "memcpy({0}{1}, {2}{1}, {3});\n".format(output, self.name, input, bytes_count)
         elif conv and direction == Direction.OUTPUT and self.is_pointer():
-            return "{0}{1} = PtrToUlong({2}{1});\n".format(output, self.name, input)
+            if self.is_function_pointer():
+                return "{0}{1} = PtrToUlong({2}{1});\n".format(output, self.name, input)
+            return "{0}{1} = wine_vk_wow64_host_to_guest_ptr({2}{1});\n".format(output, self.name, input)
         elif conv and direction == Direction.INPUT and self.is_pointer():
-            return "{0}{1} = UlongToPtr({2}{1});\n".format(output, self.name, input)
+            if self.is_function_pointer():
+                return "{0}{1} = UlongToPtr({2}{1});\n".format(output, self.name, input)
+            return "{0}{1} = wine_vk_wow64_guest_to_host_ptr({2}{1});\n".format(output, self.name, input)
         elif direction == Direction.INPUT:
             return "{0}{1} = {2};\n".format(output, self.name, self.value(input, conv))
         else:
@@ -1440,6 +1488,10 @@ class VkMember(VkVariable):
                 return True
 
         if self.is_handle():
+            if conv and unwrap == Unwrap.NONE and self.type_name == "VkCommandPool":
+                return True
+            if conv and self.handle.is_dispatchable():
+                return True
             if self.handle.is_wrapped() and self.is_dynamic_array():
                 return True
             if conv and self.handle.is_dispatchable() and self.is_static_array():
@@ -1597,7 +1649,9 @@ class Parameter(VkVariable):
                 return f"    {convert.name}({ctx_param}{value}, &{self.name}_host);\n"
 
             elif self.is_pointer_size() and self.type_name != "size_t":
-                return "    {0}_host = UlongToPtr(*{1});\n".format(self.name, self.value(prefix, conv))
+                if self.is_function_pointer():
+                    return "    {0}_host = UlongToPtr(*{1});\n".format(self.name, self.value(prefix, conv))
+                return "    {0}_host = wine_vk_wow64_guest_to_host_ptr(*{1});\n".format(self.name, self.value(prefix, conv))
             else:
                 return "    {0}_host = *{1};\n".format(self.name, self.value(prefix, conv))
         else:
@@ -1617,7 +1671,9 @@ class Parameter(VkVariable):
                 return f"    {convert.name}({ref_part}{self.name}_host, {value});\n"
 
             elif self.is_pointer_size() and self.type_name != "size_t":
-                return "    *{0} = PtrToUlong({1}_host);\n".format(self.value(prefix, conv), self.name)
+                if self.is_function_pointer():
+                    return "    *{0} = PtrToUlong({1}_host);\n".format(self.value(prefix, conv), self.name)
+                return "    *{0} = wine_vk_wow64_host_to_guest_ptr({1}_host);\n".format(self.value(prefix, conv), self.name)
             else:
                 return "    *{0} = {1}_host;\n".format(self.value(prefix, conv), self.name)
 
@@ -2072,7 +2128,7 @@ class StructConversionFunction(object):
 
         if needs_extensions:
             if self.conv and self.direction == Direction.INPUT:
-                body += f"\n    for (in_header = UlongToPtr(in->{self.operand.chain_next.name}); in_header; in_header = UlongToPtr(in_header->{self.operand.chain_next.name}))\n"
+                body += f"\n    for (in_header = wine_vk_wow64_guest_to_host_ptr(in->{self.operand.chain_next.name}); in_header; in_header = wine_vk_wow64_guest_to_host_ptr(in_header->{self.operand.chain_next.name}))\n"
             else:
                 body += f"\n    for (in_header = (void *)in->{self.operand.chain_next.name}; in_header; in_header = (void *)in_header->{self.operand.chain_next.name})\n"
             body += "    {\n"
@@ -2241,7 +2297,7 @@ class ArrayConversionFunction(object):
 
                 convert = StructConversionFunction(struct, self.direction, self.conv, self.unwrap, is_const)
                 ctx = "ctx, " if self.direction == Direction.INPUT and struct.needs_alloc(self.conv, self.unwrap) else ""
-                inp = f"({win_type} *)UlongToPtr(in[i])" if self.conv else "in[i]"
+                inp = f"({win_type} *)wine_vk_wow64_guest_to_host_ptr(in[i])" if self.conv else "in[i]"
 
                 if not pointer_array:
                     conversions.append(convert)
@@ -2257,7 +2313,7 @@ class ArrayConversionFunction(object):
                     body += u"        else\n"
                     body += u"            out[i] = NULL;\n"
                 else:
-                    body += u"        out[i] = UlongToPtr(in[i]);\n"
+                    body += u"        out[i] = wine_vk_wow64_guest_to_host_ptr(in[i]);\n"
 
             elif self.array.is_handle():
                 if pointer_array:
@@ -2266,9 +2322,9 @@ class ArrayConversionFunction(object):
                 if not self.conv or not handle.is_dispatchable():
                     input = "in[i]"
                 elif self.direction == Direction.INPUT:
-                    input = "UlongToPtr(in[i])"
+                    input = "wine_vk_wow64_guest_to_host_ptr(in[i])"
                 else:
-                    input = "PtrToUlong(in[i])"
+                    input = "wine_vk_wow64_host_to_guest_ptr(in[i])"
 
                 if self.unwrap == Unwrap.NONE or not handle.is_wrapped():
                     body += "        out[i] = {0};\n".format(input)
@@ -2278,9 +2334,9 @@ class ArrayConversionFunction(object):
                     LOGGER.warning("Unhandled handle output conversion")
             elif pointer_array:
                 if self.direction == Direction.INPUT:
-                    body += "        out[i] = UlongToPtr(in[i]);\n"
+                    body += "        out[i] = wine_vk_wow64_guest_to_host_ptr(in[i]);\n"
                 else:
-                    body += "        out[i] = PtrToUlong(in[i]);\n"
+                    body += "        out[i] = wine_vk_wow64_host_to_guest_ptr(in[i]);\n"
             else:
                 body += "        out[i] = in[i];\n"
 
diff --git a/dlls/winevulkan/vulkan.c b/dlls/winevulkan/vulkan.c
index 2dac08a..91b9a86 100644
--- a/dlls/winevulkan/vulkan.c
+++ b/dlls/winevulkan/vulkan.c
@@ -40,6 +40,16 @@ const struct vulkan_funcs *vk_funcs;
 static UINT64 call_vulkan_debug_report_callback;
 static UINT64 call_vulkan_debug_utils_callback;
 
+void *wine_vk_wow64_guest_to_host_ptr(ULONG guest)
+{
+    return guest ? ntdll_wow64_guest_to_host_ptr(guest, 1) : NULL;
+}
+
+ULONG wine_vk_wow64_host_to_guest_ptr(const void *host)
+{
+    return host ? ntdll_wow64_host_to_guest_ptr(host, 1) : 0;
+}
+
 static UINT append_string(const char *name, char *strings, UINT *strings_len)
 {
     UINT len = name ? strlen(name) + 1 : 0;
@@ -367,6 +377,14 @@ VkResult wine_vkCreateInstance(const VkInstanceCreateInfo *client_create_info, c
     struct list utils_messengers = LIST_INIT(utils_messengers), report_callbacks = LIST_INIT(report_callbacks);
     VkBaseInStructure *header = (VkBaseInStructure *)create_info;
     VkDebugReportCallbackCreateInfoEXT *debug_report_callback;
+    VkResult result;
+#ifdef __APPLE__
+    const char **host_extensions = NULL;
+    const char * const *client_extensions = create_info->ppEnabledExtensionNames;
+    uint32_t client_extension_count = create_info->enabledExtensionCount;
+    uint32_t host_extension_count = 0, i;
+    BOOL filtered_extensions = FALSE;
+#endif
 
     while ((header = find_next_struct(header->pNext, VK_STRUCTURE_TYPE_DEBUG_UTILS_MESSENGER_CREATE_INFO_EXT)))
     {
@@ -397,7 +415,37 @@ VkResult wine_vkCreateInstance(const VkInstanceCreateInfo *client_create_info, c
         list_add_tail(&report_callbacks, &report_callback->entry);
     }
 
-    return vk_funcs->p_vkCreateInstance(create_info, NULL /* allocator */, client_instance_ptr);
+#ifdef __APPLE__
+    /* VK_KHR_win32_surface is a Wine client extension, not an extension
+     * implemented by MoltenVK.  Keep it in the client instance's extension
+     * mask, but do not ask the Darwin host driver to enable it.  This keeps
+     * offscreen DXVK/vkd3d device creation independent from window-surface
+     * integration, which is implemented at vkCreateWin32SurfaceKHR instead. */
+    for (i = 0; i < client_extension_count; ++i)
+        if (strcmp(client_extensions[i], VK_KHR_WIN32_SURFACE_EXTENSION_NAME)) ++host_extension_count;
+
+    if (host_extension_count != client_extension_count)
+    {
+        if (host_extension_count && !(host_extensions = calloc(host_extension_count, sizeof(*host_extensions)))) goto failed;
+        for (i = host_extension_count = 0; i < client_extension_count; ++i)
+            if (strcmp(client_extensions[i], VK_KHR_WIN32_SURFACE_EXTENSION_NAME))
+                host_extensions[host_extension_count++] = client_extensions[i];
+        create_info->enabledExtensionCount = host_extension_count;
+        create_info->ppEnabledExtensionNames = host_extensions;
+        filtered_extensions = TRUE;
+    }
+#endif
+
+    result = vk_funcs->p_vkCreateInstance(create_info, NULL /* allocator */, client_instance_ptr);
+#ifdef __APPLE__
+    if (filtered_extensions)
+    {
+        create_info->enabledExtensionCount = client_extension_count;
+        create_info->ppEnabledExtensionNames = client_extensions;
+        free(host_extensions);
+    }
+#endif
+    return result;
 
 failed:
     free_debug_utils_messengers(&utils_messengers);
@@ -1011,7 +1059,7 @@ NTSTATUS wow64_init_vulkan(void *arg)
     struct init_params params;
     params.call_vulkan_debug_report_callback = params32->call_vulkan_debug_report_callback;
     params.call_vulkan_debug_utils_callback = params32->call_vulkan_debug_utils_callback;
-    params.extensions = UlongToPtr(params32->extensions);
+    params.extensions = wine_vk_wow64_guest_to_host_ptr(params32->extensions);
     return init_vulkan(&params);
 }
 
@@ -1022,7 +1070,8 @@ NTSTATUS vk_is_available_instance_function32(void *arg)
         UINT32 instance;
         UINT32 name;
     } *params = arg;
-    return is_available_instance_function(UlongToPtr(params->instance), UlongToPtr(params->name));
+    return is_available_instance_function(wine_vk_wow64_guest_to_host_ptr(params->instance),
+            wine_vk_wow64_guest_to_host_ptr(params->name));
 }
 
 NTSTATUS vk_is_available_device_function32(void *arg)
@@ -1032,5 +1081,6 @@ NTSTATUS vk_is_available_device_function32(void *arg)
         UINT32 device;
         UINT32 name;
     } *params = arg;
-    return is_available_device_function(UlongToPtr(params->device), UlongToPtr(params->name));
+    return is_available_device_function(wine_vk_wow64_guest_to_host_ptr(params->device),
+            wine_vk_wow64_guest_to_host_ptr(params->name));
 }
