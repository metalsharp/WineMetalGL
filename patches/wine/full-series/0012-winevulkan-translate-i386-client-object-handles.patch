+/* i386 client pointers are guest virtual addresses.  On ARM64 Darwin their
+ * backing mappings live above 4 GiB, so the wow64 Unix thunks must ask Wine's
+ * canonical guest-memory manager for the host address instead of truncating
+ * or zero-extending the 32-bit value. */
+void *wine_vk_wow64_guest_to_host_ptr(ULONG guest);
+ULONG wine_vk_wow64_host_to_guest_ptr(const void *host);
+
 struct conversion_context
 {
     char buffer[2048];
@@ -134,7 +141,7 @@ static inline void *find_next_struct32(void *s, VkStructureType t)
 {
     VkBaseOutStructure32 *header;
 
-    for (header = s; header; header = UlongToPtr(header->pNext))
+    for (header = s; header; header = wine_vk_wow64_guest_to_host_ptr(header->pNext))
     {
         if (header->sType == t)
             return header;
