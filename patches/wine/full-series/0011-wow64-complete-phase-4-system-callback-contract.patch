From d43a9901022e9d4d05717b4f779393124b5dec1e Mon Sep 17 00:00:00 2001
From: Avery Felts <averyfelts@Averys-MacBook-Air.local>
Date: Mon, 27 Jul 2026 15:34:44 -0600
Subject: [PATCH 11/19] wow64: complete phase 4 system callback contract

---
 dlls/wow64/syscall.c             | 11 ++++++++++-
 dlls/wow64/wow64.spec            |  2 ++
 dlls/wow64win/wow64win_private.h | 24 +++++++++++++-----------
 3 files changed, 25 insertions(+), 12 deletions(-)

diff --git a/dlls/wow64/syscall.c b/dlls/wow64/syscall.c
index 071f7e0..11bab68 100644
--- a/dlls/wow64/syscall.c
+++ b/dlls/wow64/syscall.c
@@ -680,12 +680,21 @@ NTSTATUS WINAPI wow64_NtClose( UINT *args )
 NTSTATUS WINAPI wow64_NtContinueEx( UINT *args )
 {
     void *context = get_ptr( &args );
-    KCONTINUE_ARGUMENT *cont_args = get_ptr( &args );
+    ULONG cont_arg32 = get_ulong( &args );
+    KCONTINUE_ARGUMENT *cont_args;
 
     NTSTATUS status = get_context_return_value( context );
     struct user_apc_frame *frame = NtCurrentTeb()->TlsSlots[WOW64_TLS_APCLIST];
     BOOL alertable;
 
+    /* NtContinue passes its second argument as the scalar alertable value,
+     * while NtContinueEx passes a guest pointer to KCONTINUE_ARGUMENT.  Do
+     * not run the scalar 0/1 form through the guest-address translator. */
+    if (cont_arg32 > 0xff)
+        cont_args = wow64_guest_to_host_ptr( cont_arg32, sizeof(*cont_args) );
+    else
+        cont_args = ULongToPtr( cont_arg32 );
+
     pBTCpuSetContext( GetCurrentThread(), GetCurrentProcess(), NULL, context );
 
     while (frame && frame->wow_context != context) frame = frame->prev_frame;
diff --git a/dlls/wow64/wow64.spec b/dlls/wow64/wow64.spec
index 5b4e565..2b619fc 100644
--- a/dlls/wow64/wow64.spec
+++ b/dlls/wow64/wow64.spec
@@ -26,3 +26,5 @@
 @ stdcall -norelay Wow64SystemServiceEx(long ptr)
 @ stub Wow64ValidateUserCallTarget
 @ stub Wow64ValidateUserCallTargetFilter
+@ cdecl wow64_guest_to_host_ptr(long int64)
+@ cdecl wow64_host_to_guest_ptr(ptr int64)
diff --git a/dlls/wow64win/wow64win_private.h b/dlls/wow64win/wow64win_private.h
index 956e386..4a15f1c 100644
--- a/dlls/wow64win/wow64win_private.h
+++ b/dlls/wow64win/wow64win_private.h
@@ -29,6 +29,8 @@ ALL_SYSCALLS32
 #undef SYSCALL_ENTRY
 
 extern ntuser_callback user_callbacks[];
+extern void *wow64_guest_to_host_ptr( ULONG guest, SIZE_T size );
+extern ULONG wow64_host_to_guest_ptr( const void *host, SIZE_T size );
 
 struct object_attr64
 {
@@ -49,12 +51,12 @@ typedef struct
 
 static inline ULONG get_ulong( UINT **args ) { return *(*args)++; }
 static inline HANDLE get_handle( UINT **args ) { return LongToHandle( *(*args)++ ); }
-static inline void *get_ptr( UINT **args ) { return ULongToPtr( *(*args)++ ); }
+static inline void *get_ptr( UINT **args ) { return wow64_guest_to_host_ptr( *(*args)++, 1 ); }
 
 static inline void **addr_32to64( void **addr, ULONG *addr32 )
 {
     if (!addr32) return NULL;
-    *addr = ULongToPtr( *addr32 );
+    *addr = wow64_guest_to_host_ptr( *addr32, 1 );
     return addr;
 }
 
@@ -67,7 +69,7 @@ static inline SIZE_T *size_32to64( SIZE_T *size, ULONG *size32 )
 
 static inline void put_addr( ULONG *addr32, void *addr )
 {
-    if (addr32) *addr32 = PtrToUlong( addr );
+    if (addr32) *addr32 = wow64_host_to_guest_ptr( addr, 1 );
 }
 
 static inline void put_size( ULONG *size32, SIZE_T size )
@@ -80,7 +82,7 @@ static inline UNICODE_STRING *unicode_str_32to64( UNICODE_STRING *str, const UNI
     if (!str32) return NULL;
     str->Length = str32->Length;
     str->MaximumLength = str32->MaximumLength;
-    str->Buffer = ULongToPtr( str32->Buffer );
+    str->Buffer = wow64_guest_to_host_ptr( str32->Buffer, str32->Length );
     return str;
 }
 
@@ -102,10 +104,10 @@ static inline SECURITY_DESCRIPTOR *secdesc_32to64( SECURITY_DESCRIPTOR *out, con
     }
     else
     {
-        out->Owner = ULongToPtr( sd->Owner );
-        out->Group = ULongToPtr( sd->Group );
-        if (sd->Control & SE_SACL_PRESENT) out->Sacl = ULongToPtr( sd->Sacl );
-        if (sd->Control & SE_DACL_PRESENT) out->Dacl = ULongToPtr( sd->Dacl );
+        out->Owner = wow64_guest_to_host_ptr( sd->Owner, 1 );
+        out->Group = wow64_guest_to_host_ptr( sd->Group, 1 );
+        if (sd->Control & SE_SACL_PRESENT) out->Sacl = wow64_guest_to_host_ptr( sd->Sacl, 1 );
+        if (sd->Control & SE_DACL_PRESENT) out->Dacl = wow64_guest_to_host_ptr( sd->Dacl, 1 );
     }
     return out;
 }
@@ -119,9 +121,9 @@ static inline OBJECT_ATTRIBUTES *objattr_32to64( struct object_attr64 *out, cons
     out->attr.Length = sizeof(out->attr);
     out->attr.RootDirectory = LongToHandle( in->RootDirectory );
     out->attr.Attributes = in->Attributes;
-    out->attr.ObjectName = unicode_str_32to64( &out->str, ULongToPtr( in->ObjectName ));
-    out->attr.SecurityQualityOfService = ULongToPtr( in->SecurityQualityOfService );
-    out->attr.SecurityDescriptor = secdesc_32to64( &out->sd, ULongToPtr( in->SecurityDescriptor ));
+    out->attr.ObjectName = unicode_str_32to64( &out->str, wow64_guest_to_host_ptr( in->ObjectName, sizeof(UNICODE_STRING32) ));
+    out->attr.SecurityQualityOfService = wow64_guest_to_host_ptr( in->SecurityQualityOfService, 1 );
+    out->attr.SecurityDescriptor = secdesc_32to64( &out->sd, wow64_guest_to_host_ptr( in->SecurityDescriptor, sizeof(SECURITY_DESCRIPTOR) ));
     return &out->attr;
 }
 
-- 
