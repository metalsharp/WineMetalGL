From 3abfdc0ec9d5847951a8c23a441f6b9a9209d868 Mon Sep 17 00:00:00 2001
From: Avery Felts <averyfelts@Averys-MacBook-Air.local>
Date: Mon, 27 Jul 2026 01:33:58 -0600
Subject: [PATCH 03/19] ntdll: redirect ARM64EC imports to native entries

---
 dlls/ntdll/loader.c | 53 +++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 53 insertions(+)

diff --git a/dlls/ntdll/loader.c b/dlls/ntdll/loader.c
index 8bf5fae..0817b7c 100644
--- a/dlls/ntdll/loader.c
+++ b/dlls/ntdll/loader.c
@@ -1136,6 +1136,51 @@ void * WINAPI RtlFindExportedRoutineByName( HMODULE module, const char *name )
     return proc;
 }
 
+#ifdef __arm64ec__
+/*************************************************************************
+ *         redirect_arm64ec_import
+ *
+ * ARM64EC exports point at an x64 .hexpthk entry. Windows intercepts that
+ * entry and routes it to the paired ARM64 implementation. VKMT supplies the
+ * x64 runtime itself, so an ARM64EC caller must receive the paired ARM64
+ * entry directly; a true x64 caller intentionally remains on the x64 path.
+ */
+static FARPROC redirect_arm64ec_import( HMODULE importer, HMODULE imported, FARPROC proc )
+{
+    const IMAGE_LOAD_CONFIG_DIRECTORY *importer_cfg, *imported_cfg;
+    const IMAGE_ARM64EC_METADATA *metadata;
+    const IMAGE_ARM64EC_REDIRECTION_ENTRY *map;
+    ULONG importer_size, imported_size;
+    ULONG_PTR rva;
+    int min, max;
+
+    if (!proc) return NULL;
+    importer_cfg = RtlImageDirectoryEntryToData( importer, TRUE, IMAGE_DIRECTORY_ENTRY_LOAD_CONFIG,
+                                                  &importer_size );
+    imported_cfg = RtlImageDirectoryEntryToData( imported, TRUE, IMAGE_DIRECTORY_ENTRY_LOAD_CONFIG,
+                                                  &imported_size );
+    if (!importer_cfg || !imported_cfg ||
+        importer_size <= offsetof( IMAGE_LOAD_CONFIG_DIRECTORY, CHPEMetadataPointer ) ||
+        imported_size <= offsetof( IMAGE_LOAD_CONFIG_DIRECTORY, CHPEMetadataPointer ) ||
+        !importer_cfg->CHPEMetadataPointer || !imported_cfg->CHPEMetadataPointer)
+        return proc;
+
+    metadata = (const IMAGE_ARM64EC_METADATA *)imported_cfg->CHPEMetadataPointer;
+    rva = (ULONG_PTR)proc - (ULONG_PTR)imported;
+    map = get_rva( imported, metadata->RedirectionMetadata );
+    min = 0;
+    max = metadata->RedirectionMetadataCount - 1;
+    while (min <= max)
+    {
+        int pos = (min + max) / 2;
+        if (map[pos].Source == rva) return get_rva( imported, map[pos].Destination );
+        if (map[pos].Source < rva) min = pos + 1;
+        else max = pos - 1;
+    }
+    return proc;
+}
+#endif
+
 
 /*************************************************************************
  *		import_dll
@@ -1233,6 +1278,10 @@ static BOOL import_dll( WINE_MODREF *wm, const IMAGE_IMPORT_DESCRIPTOR *descr, L
 
             thunk_list->u1.Function = (ULONG_PTR)find_ordinal_export( imp_mod, exports, exp_size,
                                                                       ordinal - exports->Base, load_path, wm, FALSE );
+#ifdef __arm64ec__
+            thunk_list->u1.Function = (ULONG_PTR)redirect_arm64ec_import( module, imp_mod,
+                                                                            (FARPROC)thunk_list->u1.Function );
+#endif
             if (!thunk_list->u1.Function)
             {
                 thunk_list->u1.Function = allocate_stub( name, IntToPtr(ordinal) );
@@ -1249,6 +1298,10 @@ static BOOL import_dll( WINE_MODREF *wm, const IMAGE_IMPORT_DESCRIPTOR *descr, L
             thunk_list->u1.Function = (ULONG_PTR)find_named_export( imp_mod, exports, exp_size,
                                                                     (const char*)pe_name->Name,
                                                                     pe_name->Hint, load_path, wm, FALSE );
+#ifdef __arm64ec__
+            thunk_list->u1.Function = (ULONG_PTR)redirect_arm64ec_import( module, imp_mod,
+                                                                            (FARPROC)thunk_list->u1.Function );
+#endif
             if (!thunk_list->u1.Function)
             {
                 thunk_list->u1.Function = allocate_stub( name, (const char*)pe_name->Name );
