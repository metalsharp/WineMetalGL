         (res = allocate_external_host_memory( device, alloc_info, mem_flags, &host_pointer_info )))
         return res;
 
@@ -1054,6 +1080,7 @@ static void win32u_vkFreeMemory( VkDevice client_device, VkDeviceMemory client_m
     if (memory->vm_map)
     {
         SIZE_T alloc_size = 0;
+        if (zero_bits) ntdll_wow64_unmap_host_memory( memory->vm_map, memory->size );
         NtFreeVirtualMemory( GetCurrentProcess(), &memory->vm_map, &alloc_size, MEM_RELEASE );
     }
 
@@ -1143,8 +1170,8 @@ static VkResult win32u_vkMapMemory2KHR( VkDevice client_device, const VkMemoryMa
         info.size = VK_WHOLE_SIZE;
         info.flags |= VK_MEMORY_MAP_PLACED_BIT_EXT;
 
-        if (NtAllocateVirtualMemory( GetCurrentProcess(), &placed_info.pPlacedAddress, zero_bits,
-                                     &alloc_size, MEM_COMMIT, PAGE_READWRITE ))
+        if (wow64_allocate_guest_mapping( &placed_info.pPlacedAddress, &alloc_size,
