+/* ARM64 Unix libraries cannot import PE-side WoW64 exports directly.  The
+ * ARM64 wow64.dll registers Wine's canonical i386 guest-memory converters
+ * through this native call, and Unix bridges consume the exported wrappers. */
+struct wow64_pointer_conversion_params
+{
+    UINT64 guest_to_host;
+    UINT64 host_to_guest;
+    UINT64 map_guest_memory;
+    UINT64 unmap_guest_memory;
+};
+
