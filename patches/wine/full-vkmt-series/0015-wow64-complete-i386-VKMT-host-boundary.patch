     {
         ERR( "NtAllocateVirtualMemory failed\n" );
         return VK_ERROR_OUT_OF_HOST_MEMORY;
     }
 
+    if (zero_bits && !ntdll_wow64_map_host_memory( mapping, alloc_size ))
+    {
+        SIZE_T release_size = 0;
+        NtFreeVirtualMemory( GetCurrentProcess(), &mapping, &release_size, MEM_RELEASE );
