diff --git a/dlls/ntdll/signal_arm64.c b/dlls/ntdll/signal_arm64.c
index 1245b1a..c921f60 100644
--- a/dlls/ntdll/signal_arm64.c
+++ b/dlls/ntdll/signal_arm64.c
@@ -420,30 +420,73 @@ __ASM_GLOBAL_FUNC( invoke_callback,
 void CDECL RtlRestoreContext( CONTEXT *context, EXCEPTION_RECORD *rec )
 {
     EXCEPTION_REGISTRATION_RECORD *teb_frame = NtCurrentTeb()->Tib.ExceptionList;
+    struct fex_recovery_state
+    {
+        ULONGLONG magic, armed, dispatcher_pc, guest_page_table, current_frame, callret_sp, returning_sp;
+        ULONGLONG unix_state_dst, unix_state_src, unix_state_size, unix_state_armed;
+    } *fex_recovery;
+    BOOL fex_resume = FALSE;
 
     if (rec && rec->ExceptionCode == STATUS_LONGJUMP && rec->NumberParameters >= 1)
     {
         struct _JUMP_BUFFER *jmp = (struct _JUMP_BUFFER *)rec->ExceptionInformation[0];
         int i;
 
-        context->X19  = jmp->X19;
-        context->X20  = jmp->X20;
-        context->X21  = jmp->X21;
-        context->X22  = jmp->X22;
-        context->X23  = jmp->X23;
-        context->X24  = jmp->X24;
-        context->X25  = jmp->X25;
-        context->X26  = jmp->X26;
-        context->X27  = jmp->X27;
-        context->X28  = jmp->X28;
-        context->Fp   = jmp->Fp;
-        context->Pc   = jmp->Lr;
-        context->Sp   = jmp->Sp;
-        context->Fpcr = jmp->Fpcr;
-        context->Fpsr = jmp->Fpsr;
-
-        for (i = 0; i < 8; i++)
-            context->V[8+i].D[0] = jmp->D[i];
+        /* A Unix-call snapshot is armed only while FEX is executing a native
+         * Wine Unix bridge.  A nested i386 callback may longjmp out of that
+         * bridge; restore the durable outer CPU state and re-enter FillSRA.
+         * Do not redirect ordinary user-callback longjmps, which must finish
+         * through Wow64KiUserCallbackDispatcher. */
+        fex_recovery = NtCurrentTeb()->TlsSlots[WOW64_TLS_FEX_RECOVER];
+        if (fex_recovery && fex_recovery->magic == 0x465845574f573634ULL &&
+            fex_recovery->armed && fex_recovery->dispatcher_pc && fex_recovery->guest_page_table &&
+            fex_recovery->current_frame && fex_recovery->callret_sp && fex_recovery->returning_sp &&
+            fex_recovery->unix_state_armed && fex_recovery->unix_state_dst &&
+            fex_recovery->unix_state_src && fex_recovery->unix_state_size <= 0x2000)
+        {
+            memcpy( (void *)(ULONG_PTR)fex_recovery->unix_state_dst,
+                    (const void *)(ULONG_PTR)fex_recovery->unix_state_src,
+                    (SIZE_T)fex_recovery->unix_state_size );
+            fex_recovery->unix_state_armed = 0;
+            context->X19 = fex_recovery->guest_page_table;
+            context->X23 = fex_recovery->current_frame;
+            context->X24 = 0;
+            context->X25 = fex_recovery->callret_sp;
+            context->X1  = 0;
+            context->Pc  = fex_recovery->dispatcher_pc;
+            context->Sp  = fex_recovery->returning_sp;
+            fex_recovery->armed = 0;
+            fex_resume = TRUE;
+        }
+
+        if (!fex_resume)
+        {
+            context->X19  = jmp->X19;
+            context->X20  = jmp->X20;
+            context->X21  = jmp->X21;
+            context->X22  = jmp->X22;
+            context->X23  = jmp->X23;
+            context->X24  = jmp->X24;
+            context->X25  = jmp->X25;
+            context->X26  = jmp->X26;
+            context->X27  = jmp->X27;
+            /* Darwin has no usable x18 TLS register.  VKMT keeps Wine's
+             * native TEB in x28 instead, so it is process ABI state rather
+             * than application context.  Do not restore an arbitrary
+             * jump-buffer value here: doing so poisons the next Unix-call
+             * or wait entered by an i386 FEX worker thread. */
+#ifndef __APPLE__
+            context->X28  = jmp->X28;
+#endif
+            context->Fp   = jmp->Fp;
+            context->Pc   = jmp->Lr;
+            context->Sp   = jmp->Sp;
+            context->Fpcr = jmp->Fpcr;
+            context->Fpsr = jmp->Fpsr;
+
+            for (i = 0; i < 8; i++)
+                context->V[8+i].D[0] = jmp->D[i];
+        }
     }
     else if (rec && rec->ExceptionCode == STATUS_UNWIND_CONSOLIDATE && rec->NumberParameters >= 1)
     {
diff --git a/dlls/ntdll/unix/env.c b/dlls/ntdll/unix/env.c
index fd555a0..5789c91 100644
--- a/dlls/ntdll/unix/env.c
+++ b/dlls/ntdll/unix/env.c
@@ -2348,6 +2348,10 @@ void WINAPI RtlInitCodePageTable( USHORT *ptr, CPTABLEINFO *info )
 {
     static const CPTABLEINFO utf8_cpinfo = { CP_UTF8, 4, '?', 0xfffd, '?', '?' };
 
+    /* i386 PEB/NLS fields retain guest VAs.  This native ARM64 entry point is
+     * reached directly through the hybrid ntdll surface, so translate the
+     * table before dereferencing it on hosts that cannot map below 4 GiB. */
+    ptr = virtual_wow64_guest_to_host( (ULONG_PTR)ptr );
     if (ptr[1] == CP_UTF8) *info = utf8_cpinfo;
     else init_codepage_table( ptr, info );
 }
