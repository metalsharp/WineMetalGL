diff --git a/dlls/ntdll/unix/virtual.c b/dlls/ntdll/unix/virtual.c
index b7927fc..f055fe9 100644
--- a/dlls/ntdll/unix/virtual.c
+++ b/dlls/ntdll/unix/virtual.c
@@ -32,6 +32,7 @@
 #include <string.h>
 #include <stdlib.h>
 #include <signal.h>
+#include <pthread.h>
 #include <sys/types.h>
 #include <sys/socket.h>
 #include <sys/stat.h>
@@ -218,10 +219,133 @@ ULONG_PTR user_space_wow_limit = 0;
  * Darwin's protected low-address boundary. */
 static ULONG_PTR wow64_host_bias;
 static void *wow64_user_shared_data;
+static void * (CDECL *wow64_guest_to_host_ptr)( ULONG guest, SIZE_T size );
+static ULONG (CDECL *wow64_host_to_guest_ptr)( const void *host, SIZE_T size );
+static void (WINAPI *wow64_map_guest_memory)( ULONG guest, void *host, SIZE_T size );
+static void (WINAPI *wow64_unmap_guest_memory)( ULONG guest, SIZE_T size );
+
+#define WOW64_NATIVE_MAP_COUNT 64
+struct wow64_native_map
+{
+    ULONG guest;
+    void *host;
+    SIZE_T size;
+};
+static struct wow64_native_map wow64_native_maps[WOW64_NATIVE_MAP_COUNT];
+static pthread_mutex_t wow64_native_map_mutex = PTHREAD_MUTEX_INITIALIZER;
+static ULONG wow64_native_next_guest = 0x60000000;
+
+NTSTATUS unixcall_register_wow64_pointer_conversion( void *args )
+{
+    const struct wow64_pointer_conversion_params *params = args;
+
+    if (!params || !params->guest_to_host || !params->host_to_guest ||
+        !params->map_guest_memory || !params->unmap_guest_memory)
+        return STATUS_INVALID_PARAMETER;
+    wow64_guest_to_host_ptr = (void *)(UINT_PTR)params->guest_to_host;
+    wow64_host_to_guest_ptr = (void *)(UINT_PTR)params->host_to_guest;
+    wow64_map_guest_memory = (void *)(UINT_PTR)params->map_guest_memory;
+    wow64_unmap_guest_memory = (void *)(UINT_PTR)params->unmap_guest_memory;
+    return STATUS_SUCCESS;
+}
+
+NTSYSAPI void *ntdll_wow64_guest_to_host_ptr( ULONG guest, SIZE_T size )
+{
+    if (wow64_guest_to_host_ptr) return wow64_guest_to_host_ptr( guest, size );
+    /* process_init installs the precise map callback after the native NTDLL
+     * Unix-call table exists.  Winevulkan may initialize during that same
+     * startup path, however; the Darwin WoW64 VM arena is already authoritative
+     * for ordinary client memory at this point. */
+    if (!guest || (ULONGLONG)guest + size > limit_4g) return NULL;
+    return virtual_wow64_guest_to_host( guest );
+}
+
+NTSYSAPI ULONG ntdll_wow64_host_to_guest_ptr( const void *host, SIZE_T size )
+{
+    ULONG_PTR ptr = (ULONG_PTR)host;
+    unsigned int i;
+
+    pthread_mutex_lock( &wow64_native_map_mutex );
+    for (i = 0; i < ARRAY_SIZE(wow64_native_maps); ++i)
+    {
+        struct wow64_native_map *map = &wow64_native_maps[i];
+        if (map->size && host >= map->host && size <= map->size - ((const char *)host - (const char *)map->host))
+        {
+            ULONG guest = map->guest + ((const char *)host - (const char *)map->host);
+            pthread_mutex_unlock( &wow64_native_map_mutex );
+            return guest;
+        }
+    }
+    pthread_mutex_unlock( &wow64_native_map_mutex );
+
+    if (wow64_host_to_guest_ptr) return wow64_host_to_guest_ptr( host, size );
+    if (ptr >= wow64_host_bias && ptr - wow64_host_bias <= MAXDWORD &&
+        size <= limit_4g - (ptr - wow64_host_bias))
+        return ptr - wow64_host_bias;
+    ERR( "i386 native pointer %p has no guest address before converter registration\n", host );
+    return 0;
+}
+
+NTSYSAPI ULONG ntdll_wow64_map_host_memory( void *host, SIZE_T size )
+{
+    SIZE_T span = (size + 0xffff) & ~(SIZE_T)0xffff;
+    unsigned int i;
+    ULONG guest;
+
+    if (!host || !span || !wow64_map_guest_memory) return 0;
+    pthread_mutex_lock( &wow64_native_map_mutex );
+    for (i = 0; i < ARRAY_SIZE(wow64_native_maps); ++i)
+    {
+        struct wow64_native_map *map = &wow64_native_maps[i];
+        if (map->size && host >= map->host && span <= map->size - ((char *)host - (char *)map->host))
+        {
+            guest = map->guest + ((char *)host - (char *)map->host);
+            pthread_mutex_unlock( &wow64_native_map_mutex );
+            return guest;
+        }
+    }
+    for (i = 0; i < ARRAY_SIZE(wow64_native_maps); ++i) if (!wow64_native_maps[i].size) break;
+    if (i == ARRAY_SIZE(wow64_native_maps))
+    {
+        pthread_mutex_unlock( &wow64_native_map_mutex );
+        return 0;
+    }
+    guest = wow64_native_next_guest;
+    if (guest < 0x60000000 || guest >= 0x70000000 || (ULONGLONG)guest + span > 0x70000000) guest = 0x60000000;
+    wow64_native_next_guest = guest + span;
+    wow64_native_maps[i] = (struct wow64_native_map){guest, host, span};
+    pthread_mutex_unlock( &wow64_native_map_mutex );
+
+    wow64_map_guest_memory( guest, host, span );
+    TRACE( "native i386 map %08lx -> %p (%zu)\n", guest, host, span );
+    return guest;
+}
+
+NTSYSAPI void ntdll_wow64_unmap_host_memory( void *host, SIZE_T size )
+{
+    unsigned int i;
+
+    pthread_mutex_lock( &wow64_native_map_mutex );
+    for (i = 0; i < ARRAY_SIZE(wow64_native_maps); ++i)
+    {
+        struct wow64_native_map *map = &wow64_native_maps[i];
+        if (map->size && map->host == host && (!size || map->size >= size))
+        {
+            ULONG guest = map->guest;
+            SIZE_T span = map->size;
+            map->size = 0;
+            map->host = NULL;
+            pthread_mutex_unlock( &wow64_native_map_mutex );
+            if (wow64_unmap_guest_memory) wow64_unmap_guest_memory( guest, span );
+            return;
+        }
+    }
+    pthread_mutex_unlock( &wow64_native_map_mutex );
+}
 
 /* WoW64 TEB fields retain 32-bit guest addresses.  Native code that touches
  * those fields must use the high Darwin host arena selected above. */
-static inline void *wow64_host_ptr( ULONG_PTR ptr )
+void *virtual_wow64_guest_to_host( ULONG_PTR ptr )
 {
 #if defined(__APPLE__) && defined(__aarch64__)
     if (ptr && ptr < limit_4g) ptr += wow64_host_bias;
@@ -2371,8 +2495,15 @@ static NTSTATUS map_view( struct file_view **view_ret, void *base, size_t size,
     if (is_wow64())
     {
         if (base && (ULONG_PTR)base < limit_4g) base = (char *)base + wow64_host_bias;
-        if (limit_low && limit_low < limit_4g) limit_low += wow64_host_bias;
-        if (limit_high && limit_high <= limit_4g) limit_high += wow64_host_bias;
+        /* A zero low bound is the beginning of the guest range, not the
+         * beginning of the native ARM64 address space.  Bias both ends as
+         * one range; otherwise a dynamic guest allocation can escape the
+         * aperture and be truncated when stored in a TEB32. */
+        if (limit_high && limit_high <= limit_4g)
+        {
+            if (limit_low < limit_4g) limit_low += wow64_host_bias;
+            limit_high += wow64_host_bias;
+        }
     }
 #endif
 
@@ -4357,7 +4488,7 @@ void virtual_free_thread_data( struct thread_data *data )
         NtFreeVirtualMemory( GetCurrentProcess(), (void **)&teb->ChpeV2CpuAreaInfo, &size, MEM_RELEASE );
     }
 #endif
-    if ((wow_teb = get_wow_teb( teb )) && (ptr = wow64_host_ptr( wow_teb->DeallocationStack )))
+    if ((wow_teb = get_wow_teb( teb )) && (ptr = virtual_wow64_guest_to_host( wow_teb->DeallocationStack )))
     {
         size = 0;
         NtFreeVirtualMemory( GetCurrentProcess(), &ptr, &size, MEM_RELEASE );
@@ -4553,7 +4684,7 @@ NTSTATUS virtual_clear_tls_index( ULONG index )
             if (wow_teb)
             {
                 if (wow_teb->TlsExpansionSlots)
-                    ((ULONG *)wow64_host_ptr( wow_teb->TlsExpansionSlots ))[index] = 0;
+                    ((ULONG *)virtual_wow64_guest_to_host( wow_teb->TlsExpansionSlots ))[index] = 0;
             }
             else
 #endif
@@ -4733,9 +4864,9 @@ static BOOL is_inside_thread_stack( struct thread_data *data, void *ptr, struct
     if ((char *)ptr > stack->start && (char *)ptr <= stack->end) return TRUE;
 
     if (!(wow_teb = get_wow_teb( teb ))) return FALSE;
-    stack->start = wow64_host_ptr( wow_teb->DeallocationStack );
-    stack->limit = wow64_host_ptr( wow_teb->Tib.StackLimit );
-    stack->end   = wow64_host_ptr( wow_teb->Tib.StackBase );
+    stack->start = virtual_wow64_guest_to_host( wow_teb->DeallocationStack );
+    stack->limit = virtual_wow64_guest_to_host( wow_teb->Tib.StackLimit );
+    stack->end   = virtual_wow64_guest_to_host( wow_teb->Tib.StackBase );
     stack->guaranteed = max( wow_teb->GuaranteedStackBytes, min_guaranteed );
     stack->is_wow = TRUE;
     return ((char *)ptr > stack->start && (char *)ptr <= stack->end);
diff --git a/dlls/ntdll/unixlib.h b/dlls/ntdll/unixlib.h
