+/* Native Unix code in an i386 WoW64 process must not request a low host
+ * mapping: Darwin rejects it.  A specified 32-bit guest address is translated
+ * by ntdll to its high WoW64 host alias before the VM reservation is made, so
+ * the returned mapping remains usable by ARM64 Vulkan and converts back to a
+ * valid i386 guest pointer at the WineVulkan boundary. */
+static NTSTATUS wow64_allocate_guest_mapping( void **mapping, SIZE_T *size, ULONG type, ULONG protect )
+{
+    /* Allocate at an arbitrary native address, then register the returned
+     * mapping with the canonical guest manager below.  Forcing a low address
+     * (or a fixed high-arena alias) fails because FEX owns those VM ranges. */
+    *mapping = NULL;
+    return NtAllocateVirtualMemory( GetCurrentProcess(), mapping, 0, size, type, protect );
+}
+
 struct mempool
 {
