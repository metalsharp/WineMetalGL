  *		RtlFindExportedRoutineByName
@@ -1142,27 +1145,26 @@ void * WINAPI RtlFindExportedRoutineByName( HMODULE module, const char *name )
  *
  * ARM64EC exports point at an x64 .hexpthk entry. Windows intercepts that
  * entry and routes it to the paired ARM64 implementation. VKMT supplies the
- * x64 runtime itself, so an ARM64EC caller must receive the paired ARM64
- * entry directly; a true x64 caller intentionally remains on the x64 path.
+ * x64 runtime itself, so an ARM64EC or pure ARM64 caller must receive the
+ * paired ARM64 entry directly; a true x64 caller intentionally remains on
+ * the x64 path.  The importing module need not itself carry CHPE metadata:
+ * external native ARM64 modules such as vkd3d-proton are ordinary ARM64 PEs.
  */
-static FARPROC redirect_arm64ec_import( HMODULE importer, HMODULE imported, FARPROC proc )
+static FARPROC redirect_arm64ec_import( HMODULE imported, FARPROC proc )
 {
-    const IMAGE_LOAD_CONFIG_DIRECTORY *importer_cfg, *imported_cfg;
+    const IMAGE_LOAD_CONFIG_DIRECTORY *imported_cfg;
     const IMAGE_ARM64EC_METADATA *metadata;
     const IMAGE_ARM64EC_REDIRECTION_ENTRY *map;
-    ULONG importer_size, imported_size;
+    ULONG imported_size;
     ULONG_PTR rva;
     int min, max;
 
     if (!proc || is_amd64_guest_process) return proc;
-    importer_cfg = RtlImageDirectoryEntryToData( importer, TRUE, IMAGE_DIRECTORY_ENTRY_LOAD_CONFIG,
-                                                  &importer_size );
     imported_cfg = RtlImageDirectoryEntryToData( imported, TRUE, IMAGE_DIRECTORY_ENTRY_LOAD_CONFIG,
                                                   &imported_size );
-    if (!importer_cfg || !imported_cfg ||
-        importer_size <= offsetof( IMAGE_LOAD_CONFIG_DIRECTORY, CHPEMetadataPointer ) ||
+    if (!imported_cfg ||
         imported_size <= offsetof( IMAGE_LOAD_CONFIG_DIRECTORY, CHPEMetadataPointer ) ||
-        !importer_cfg->CHPEMetadataPointer || !imported_cfg->CHPEMetadataPointer)
+        !imported_cfg->CHPEMetadataPointer)
         return proc;
 
     metadata = (const IMAGE_ARM64EC_METADATA *)imported_cfg->CHPEMetadataPointer;
@@ -1279,7 +1281,7 @@ static BOOL import_dll( WINE_MODREF *wm, const IMAGE_IMPORT_DESCRIPTOR *descr, L
             thunk_list->u1.Function = (ULONG_PTR)find_ordinal_export( imp_mod, exports, exp_size,
                                                                       ordinal - exports->Base, load_path, wm, FALSE );
 #ifdef __arm64ec__
-            thunk_list->u1.Function = (ULONG_PTR)redirect_arm64ec_import( module, imp_mod,
+            thunk_list->u1.Function = (ULONG_PTR)redirect_arm64ec_import( imp_mod,
                                                                             (FARPROC)thunk_list->u1.Function );
 #endif
             if (!thunk_list->u1.Function)
@@ -1299,7 +1301,7 @@ static BOOL import_dll( WINE_MODREF *wm, const IMAGE_IMPORT_DESCRIPTOR *descr, L
                                                                     (const char*)pe_name->Name,
                                                                     pe_name->Hint, load_path, wm, FALSE );
 #ifdef __arm64ec__
-            thunk_list->u1.Function = (ULONG_PTR)redirect_arm64ec_import( module, imp_mod,
+            thunk_list->u1.Function = (ULONG_PTR)redirect_arm64ec_import( imp_mod,
                                                                             (FARPROC)thunk_list->u1.Function );
 #endif
             if (!thunk_list->u1.Function)
@@ -2139,6 +2141,11 @@ NTSTATUS WINAPI LdrGetProcedureAddress(HMODULE module, const ANSI_STRING *name,
                           : find_ordinal_export( module, exports, exp_size, ord - exports->Base, NULL, wm, TRUE );
         if (proc)
         {
+#ifdef __arm64ec__
+            /* Native ARM64 clients resolve Vulkan entry points dynamically.
+             * Do the same ARM64EC-to-ARM64 redirect used for IAT imports. */
+            proc = redirect_arm64ec_import( module, proc );
+#endif
             *address = proc;
             ret = STATUS_SUCCESS;
         }
