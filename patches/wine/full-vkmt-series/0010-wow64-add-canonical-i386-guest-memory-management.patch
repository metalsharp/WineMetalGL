diff --git a/dlls/ntdll/unix/signal_arm64.c b/dlls/ntdll/unix/signal_arm64.c
index 522ade3..da63868 100644
--- a/dlls/ntdll/unix/signal_arm64.c
+++ b/dlls/ntdll/unix/signal_arm64.c
@@ -61,6 +61,15 @@
 
 WINE_DEFAULT_DEBUG_CHANNEL(seh);
 
+#ifdef __APPLE__
+/* VKMT: Darwin scrubs x18 on every kernel->user boundary, so the Windows TEB
+ * cannot live in x18 in PE code. PE is built with -ffixed-x28 and keeps the
+ * TEB in x28, which the Darwin kernel preserves like any callee-saved reg. */
+#define __ASM_TEB_REG "x28"
+#else
+#define __ASM_TEB_REG "x18"
+#endif
+
 #define NTDLL_DWARF_H_NO_UNWINDER
 #include "dwarf.h"
 
@@ -421,9 +430,14 @@ NTSTATUS WINAPI NtSetContextThread( HANDLE handle, const CONTEXT *context )
 
     if (flags & CONTEXT_INTEGER)
     {
+#ifdef __APPLE__
+        /* VKMT: skip x28 (the TEB register in PE code), not x18 */
+        memcpy( frame->x, context->X, sizeof(context->X[0]) * 28 );
+#else
         memcpy( frame->x, context->X, sizeof(context->X[0]) * 18 );
         /* skip x18 */
         memcpy( frame->x + 19, context->X + 19, sizeof(context->X[0]) * 10 );
+#endif
     }
     if (flags & CONTEXT_CONTROL)
     {
@@ -775,7 +789,12 @@ static void setup_raise_exception( struct thread_data *data, ucontext_t *sigcont
 
     SP_sig(sigcontext) = (ULONG_PTR)stack;
     PC_sig(sigcontext) = (ULONG_PTR)pKiUserExceptionDispatcher;
+#ifdef __APPLE__
+    /* VKMT: TEB lives in x28 in PE code (Darwin scrubs x18) */
+    REGn_sig(28, sigcontext) = (ULONG_PTR)data->teb;
+#else
     REGn_sig(18, sigcontext) = (ULONG_PTR)data->teb;
+#endif
 }
 
 
@@ -883,24 +902,24 @@ __ASM_GLOBAL_FUNC( call_user_mode_callback,
                    "stp d12, d13, [x29, #0x80]\n\t"
                    "stp d14, d15, [x29, #0x90]\n\t"
                    "stp x1, x2, [x29, #0xa0]\n\t" /* ret_ptr, ret_len */
-                   "mov x18, x4\n\t"              /* teb */
+                   "mov " __ASM_TEB_REG ", x4\n\t"  /* teb */
                    "mrs x1, fpcr\n\t"
                    "mrs x2, fpsr\n\t"
                    "bfi x1, x2, #0, #32\n\t"
-                   "ldr x2, [x18]\n\t"            /* teb->Tib.ExceptionList */
+                   "ldr x2, [" __ASM_TEB_REG "]\n\t"  /* teb->Tib.ExceptionList */
                    "stp x1, x2, [x29, #0xb0]\n\t"
 
-                   "ldr x7, [x18, #0x378]\n\t"    /* thread_data->syscall_frame */
+                   "ldr x7, [" __ASM_TEB_REG ", #0x378]\n\t" /* thread_data->syscall_frame */
                    "sub x1, sp, #0x330\n\t"       /* sizeof(struct syscall_frame) */
-                   "str x1, [x18, #0x378]\n\t"    /* thread_data->syscall_frame */
