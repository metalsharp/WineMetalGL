diff --git a/configure b/configure
index 5cd54ad..75290c1 100755
--- a/configure
+++ b/configure
@@ -7627,6 +7627,12 @@ else case e in #(
   e) eval "${wine_arch}_CFLAGS=\${CROSSCFLAGS:-\"-g -O2\"}" ;;
 esac
 fi
+        case $wine_arch in #(
+  aarch64|arm64ec) :
+    as_fn_append ${wine_arch}_CFLAGS " -ffixed-x18 -ffixed-x28" ;; #(
+  *) :
+     ;;
+esac
     if eval test \${${wine_arch}_LDFLAGS+y}
 then :
 
@@ -12359,7 +12365,7 @@ case $host_os in
     SYSTEMCONFIGURATION_LIBS="-framework SystemConfiguration"
 
 
-    WINELOADER_LDFLAGS="-Wl,-segalign,0x1000,-pagezero_size,0x1000,-sectcreate,__TEXT,__info_plist,loader/wine_info.plist"
+                    WINELOADER_LDFLAGS=""
 
     case $HOST_ARCH in
       i386) wine_use_preloader=yes ;;
diff --git a/configure.ac b/configure.ac
index a8e3bf7..38ceef1 100644
--- a/configure.ac
+++ b/configure.ac
@@ -449,6 +449,8 @@ do
 
     CPPFLAGS=""
     AS_VAR_SET_IF([${wine_arch}_CFLAGS],[],[AS_VAR_SET([${wine_arch}_CFLAGS],[${CROSSCFLAGS:-"-g -O2"}])])
+    dnl VKMT: PE TEB lives in x28 on Darwin (x18 is scrubbed by the kernel); keep clang from allocating it
+    AS_CASE([$wine_arch],[aarch64|arm64ec],[AS_VAR_APPEND([${wine_arch}_CFLAGS],[" -ffixed-x18 -ffixed-x28"])])
     AS_VAR_SET_IF([${wine_arch}_LDFLAGS],[],[AS_VAR_SET([${wine_arch}_LDFLAGS],[$CROSSLDFLAGS])])
     AS_VAR_SET_IF([${wine_arch}_CXX],[],[AS_VAR_COPY([${wine_arch}_CXX],[${wine_arch}_CC])])
     AS_VAR_SET_IF([${wine_arch}_CXXFLAGS],[],[AS_VAR_COPY([${wine_arch}_CXXFLAGS],[${wine_arch}_CFLAGS])])
@@ -989,7 +991,11 @@ case $host_os in
     AC_SUBST(SECURITY_LIBS,"-framework Security -framework CoreFoundation")
     AC_SUBST(SYSTEMCONFIGURATION_LIBS,"-framework SystemConfiguration")
 
-    WINELOADER_LDFLAGS="-Wl,-segalign,0x1000,-pagezero_size,0x1000,-sectcreate,__TEXT,__info_plist,loader/wine_info.plist"
+    dnl VKMT: dropped -pagezero_size,0x1000 — macOS 15+ kills ad-hoc-signed
+    dnl executables with a small __PAGEZERO at exec; arm64 does not use the
+    dnl preloader path, and the 4GB reservation is handled at runtime instead.
+    dnl VKMT: empty on macOS 15+; -segalign,0x1000 produces an exec-killed layout
+    WINELOADER_LDFLAGS=""
 
     case $HOST_ARCH in
       i386) wine_use_preloader=yes ;;
