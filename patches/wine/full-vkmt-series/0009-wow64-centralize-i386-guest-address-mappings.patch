diff --git a/dlls/wow64/memory.c b/dlls/wow64/memory.c
new file mode 100644
index 0000000..03c440c
--- /dev/null
+++ b/dlls/wow64/memory.c
@@ -0,0 +1,220 @@
+/*
+ * WoW64 i386 guest address manager.
+ *
+ * Guest addresses are always 32-bit values.  Host mappings are registered as
+ * explicit guest/host ranges and are never converted by truncating a host
+ * pointer.  The initial high aperture is retained only as a compatibility
+ * mapping for Wine's existing Darwin ARM64 VM implementation; explicit
+ * records take precedence and allow non-contiguous host mappings.
+ */
+
+#include <stdarg.h>
+
+#include "ntstatus.h"
+#include "windef.h"
+#include "winnt.h"
+#include "winternl.h"
+#include "wow64_private.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(wow);
+
+#define WOW64_GUEST_MAP_COUNT 256
+
+struct guest_map
+{
+    ULONG guest;
+    SIZE_T size;
+    char *host;
+};
+
+static struct guest_map guest_maps[WOW64_GUEST_MAP_COUNT];
+static RTL_SRWLOCK guest_map_lock = RTL_SRWLOCK_INIT;
+static BOOL guest_memory_initialized;
+
+static BOOL contains_guest( const struct guest_map *map, ULONG guest, SIZE_T size )
+{
+    ULONGLONG end = (ULONGLONG)guest + size;
+    return map->size && guest >= map->guest && end <= (ULONGLONG)map->guest + map->size;
+}
+
+static BOOL contains_host( const struct guest_map *map, const char *host, SIZE_T size )
+{
+    return map->size && host >= map->host && size <= map->size - (host - map->host);
+}
+
+void wow64_register_guest_memory( ULONG guest, void *host, SIZE_T size )
+{
+    unsigned int i, free_slot = WOW64_GUEST_MAP_COUNT;
+
+    if (!host || !size) return;
+    RtlAcquireSRWLockExclusive( &guest_map_lock );
+    for (i = 0; i < ARRAY_SIZE(guest_maps); i++)
+    {
+        if (guest_maps[i].host == host && guest_maps[i].guest == guest)
+        {
+            guest_maps[i].size = size;
+            RtlReleaseSRWLockExclusive( &guest_map_lock );
+            return;
+        }
+        if (!guest_maps[i].size && free_slot == ARRAY_SIZE(guest_maps)) free_slot = i;
+    }
+    if (free_slot == ARRAY_SIZE(guest_maps))
+    {
+        ERR( "i386 guest map table exhausted registering %08lx -> %p (%Iu)\n", guest, host, size );
+    }
+    else
+    {
+        guest_maps[free_slot].guest = guest;
+        guest_maps[free_slot].host = host;
+        guest_maps[free_slot].size = size;
+        TRACE( "i386 guest map %08lx -> %p (%Iu)\n", guest, host, size );
+    }
+    RtlReleaseSRWLockExclusive( &guest_map_lock );
+}
+
+void wow64_unregister_guest_memory( ULONG guest, SIZE_T size )
+{
+    unsigned int i;
+
+    RtlAcquireSRWLockExclusive( &guest_map_lock );
+    for (i = 0; i < ARRAY_SIZE(guest_maps); i++)
+    {
+        if (guest_maps[i].guest == guest && (!size || guest_maps[i].size == size))
+        {
+            TRACE( "i386 guest unmap %08lx -> %p (%Iu)\n", guest, guest_maps[i].host, guest_maps[i].size );
+            guest_maps[i].size = 0;
+            guest_maps[i].host = NULL;
+            break;
+        }
+    }
+    RtlReleaseSRWLockExclusive( &guest_map_lock );
+}
+
+void wow64_guest_memory_init(void)
+{
+    TEB32 *teb32;
+    PEB32 *peb32;
+    RTL_USER_PROCESS_PARAMETERS32 *params32;
+    ULONG guest;
+    ULONG_PTR host_base;
+
+    if (guest_memory_initialized) return;
+    teb32 = NtCurrentTeb32();
+    guest = (ULONG)(ULONG_PTR)teb32;
+    host_base = (ULONG_PTR)teb32 - guest;
+
+    /* Existing Darwin ARM64 views are biased by a 4GiB-aligned base.  Record
+     * that aperture explicitly rather than reproducing its arithmetic at each
+     * call site.  Explicit VM/image/stack records below override this entry. */
+    wow64_register_guest_memory( 0, (void *)host_base, (SIZE_T)MAXDWORD + 1 );
+    guest_memory_initialized = TRUE;
+    wow64_register_guest_memory( guest, teb32, sizeof(*teb32) );
+    peb32 = wow64_guest_to_host_ptr( teb32->Peb, sizeof(*peb32) );
+    if (peb32)
+    {
+        wow64_register_guest_memory( teb32->Peb, peb32, sizeof(*peb32) );
+        params32 = wow64_guest_to_host_ptr( peb32->ProcessParameters, sizeof(*params32) );
+        if (params32 && params32->AllocationSize)
+            wow64_register_guest_memory( peb32->ProcessParameters, params32, params32->AllocationSize );
+    }
+    if (teb32->Tib.StackLimit && teb32->Tib.StackBase && teb32->Tib.StackLimit < teb32->Tib.StackBase)
+        wow64_register_guest_memory( teb32->Tib.StackLimit,
+                                     wow64_guest_to_host_ptr( teb32->Tib.StackLimit, 1 ),
+                                     teb32->Tib.StackBase - teb32->Tib.StackLimit );
+    wow64_register_guest_memory( 0x7ffe0000, wow64_guest_to_host_ptr( 0x7ffe0000, 1 ), 0x1000 );
+    TRACE( "i386 guest aperture %08x..ffffffff -> %p\n", 0, (void *)host_base );
+}
+
+BOOL wow64_guest_memory_selftest(void)
+{
+    static const ULONG alloc_guest = 0x51000000;
+    static const ULONG map_guest = 0x52000000;
+    void *alloc = NULL, *map = NULL;
+    SIZE_T size = 0x4000, map_size = 0x4000;
+    LARGE_INTEGER section_size;
+    HANDLE section = NULL;
+    ULONG old_prot;
+    NTSTATUS status;
+
+    status = NtAllocateVirtualMemory( GetCurrentProcess(), &alloc, 0, &size,
+                                      MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE );
+    if (status || (ULONG_PTR)alloc < 0x100000000ULL) goto failed;
+    wow64_register_guest_memory( alloc_guest, alloc, size );
+    if (wow64_guest_to_host_ptr( alloc_guest + 0x123, 1 ) != (char *)alloc + 0x123 ||
+        wow64_host_to_guest_ptr( (char *)alloc + 0x321, 1 ) != alloc_guest + 0x321) goto failed;
+    status = NtProtectVirtualMemory( GetCurrentProcess(), &alloc, &size, PAGE_READONLY, &old_prot );
+    if (status) goto failed;
+    wow64_unregister_guest_memory( alloc_guest, 0 );
+    status = NtFreeVirtualMemory( GetCurrentProcess(), &alloc, &size, MEM_RELEASE );
+    if (status) goto failed;
+
+    section_size.QuadPart = map_size;
+    status = NtCreateSection( &section, SECTION_ALL_ACCESS, NULL, &section_size,
+                              PAGE_READWRITE, SEC_COMMIT, NULL );
+    if (status) goto failed;
+    status = NtMapViewOfSection( section, GetCurrentProcess(), &map, 0, 0, NULL,
+                                 &map_size, ViewUnmap, 0, PAGE_READWRITE );
+    if (status || (ULONG_PTR)map < 0x100000000ULL) goto failed;
+    wow64_register_guest_memory( map_guest, map, map_size );
+    if (wow64_guest_to_host_ptr( map_guest + 0x111, 1 ) != (char *)map + 0x111) goto failed;
+    wow64_unregister_guest_memory( map_guest, 0 );
+    status = NtUnmapViewOfSection( GetCurrentProcess(), map );
+    if (status) goto failed;
+    NtClose( section );
+    TRACE( "i386 guest memory selftest passed: allocate/map/protect/unmap above 4GiB\n" );
+    return TRUE;
+
+failed:
+    ERR( "i386 guest memory selftest failed: status %#lx alloc %p map %p\n", status, alloc, map );
+    if (map) NtUnmapViewOfSection( GetCurrentProcess(), map );
+    if (section) NtClose( section );
+    if (alloc)
+    {
+        size = 0;
+        NtFreeVirtualMemory( GetCurrentProcess(), &alloc, &size, MEM_RELEASE );
+    }
+    return FALSE;
+}
+
+void *wow64_guest_to_host_ptr( ULONG guest, SIZE_T size )
+{
+    unsigned int i;
+    void *ret = NULL;
+
+    if (!guest) return NULL;
+    if (!guest_memory_initialized) wow64_guest_memory_init();
+    RtlAcquireSRWLockShared( &guest_map_lock );
+    for (i = ARRAY_SIZE(guest_maps); i-- > 0; )
+    {
+        if (contains_guest( &guest_maps[i], guest, size ))
+        {
+            ret = guest_maps[i].host + (guest - guest_maps[i].guest);
+            break;
+        }
+    }
+    RtlReleaseSRWLockShared( &guest_map_lock );
+    if (!ret) ERR( "unmapped i386 guest pointer %08lx (%Iu bytes)\n", guest, size );
+    return ret;
+}
+
+ULONG wow64_host_to_guest_ptr( const void *host, SIZE_T size )
+{
+    unsigned int i;
+    ULONG ret = 0;
+
+    if (!host) return 0;
+    if (!guest_memory_initialized) wow64_guest_memory_init();
+    RtlAcquireSRWLockShared( &guest_map_lock );
+    for (i = ARRAY_SIZE(guest_maps); i-- > 0; )
+    {
+        if (contains_host( &guest_maps[i], host, size ))
+        {
+            ret = guest_maps[i].guest + ((const char *)host - guest_maps[i].host);
+            break;
+        }
+    }
+    RtlReleaseSRWLockShared( &guest_map_lock );
+    if (!ret) ERR( "unmapped native pointer %p (%Iu bytes) has no i386 guest address\n", host, size );
+    return ret;
+}
